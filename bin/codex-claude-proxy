#!/usr/bin/env bash
set -euo pipefail

PROJECT_DIR="$HOME/70_RUNTIME_LOCAL/AI/Agents/claude-code-codex-bridge"
MODE="${1:-safe}"

if [[ ! -d "$PROJECT_DIR" ]]; then
  echo "Erro: diretório não encontrado: $PROJECT_DIR"
  exit 1
fi

if [[ ! -f "$PROJECT_DIR/codex_claude_proxy.py" ]]; then
  echo "Erro: codex_claude_proxy.py não encontrado em:"
  echo "$PROJECT_DIR"
  exit 1
fi

if [[ ! -x "$PROJECT_DIR/.venv/bin/python" ]]; then
  echo "Erro: venv não encontrado em:"
  echo "$PROJECT_DIR/.venv"
  exit 1
fi

if ! command -v codex >/dev/null 2>&1; then
  echo "Erro: codex CLI não encontrado."
  exit 1
fi

case "$MODE" in
  safe)
    export CODEX_CLAUDE_SANDBOX="workspace-write"
    ;;
  full)
    export CODEX_CLAUDE_SANDBOX="danger-full-access"
    ;;
  readonly|read-only)
    export CODEX_CLAUDE_SANDBOX="read-only"
    ;;
  *)
    echo "Uso:"
    echo "  codex-claude-proxy safe      # escreve só no workspace"
    echo "  codex-claude-proxy full      # rede + acesso amplo, use só para tarefas confiáveis"
    echo "  codex-claude-proxy readonly  # leitura apenas"
    exit 1
    ;;
esac

export CODEX_CLAUDE_HOST="127.0.0.1"
export CODEX_CLAUDE_PORT="4100"
export CODEX_CLAUDE_AUTH_TOKEN="sk-local-codex"
export CODEX_CLAUDE_MODEL_HAIKU="${CODEX_CLAUDE_MODEL_HAIKU:-gpt-5.4-mini}"
export CODEX_CLAUDE_MODEL_SONNET="${CODEX_CLAUDE_MODEL_SONNET:-gpt-5.4}"
export CODEX_CLAUDE_MODEL_FABLE="${CODEX_CLAUDE_MODEL_FABLE:-gpt-5.4}"
export CODEX_CLAUDE_MODEL_OPUS="${CODEX_CLAUDE_MODEL_OPUS:-gpt-5.5}"
export CODEX_CLAUDE_MODEL_CODING="${CODEX_CLAUDE_MODEL_CODING:-gpt-5.3-codex}"
export CODEX_CLAUDE_TIMEOUT="${CODEX_CLAUDE_TIMEOUT:-600}"
export CODEX_CLAUDE_CWD="$PWD"

cd "$PROJECT_DIR"

echo "Iniciando codex-claude-proxy..."
echo "URL: http://127.0.0.1:4100"
echo "Modo: $MODE"
echo "Sandbox Codex: $CODEX_CLAUDE_SANDBOX"
echo "Projeto do proxy: $PROJECT_DIR"
echo "CWD para o Codex: $CODEX_CLAUDE_CWD"
echo ""

exec "$PROJECT_DIR/.venv/bin/python" "$PROJECT_DIR/codex_claude_proxy.py"